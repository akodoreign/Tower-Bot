# Discord Bot Configuration
DISCORD_BOT_TOKEN=

# Logging and Behavior
LOGGING=True
REPLYING_ALL=False

# Discord Channel IDs
DISCORD_CHANNEL_ID=
REPLYING_ALL_DISCORD_CHANNEL_ID=
MISSION_BOARD_CHANNEL_ID=1459652462045827113  # channel where mission board posts live
MISSION_BOARD_MAX_ACTIVE_NORMAL=45            # non-personal open mission cap before posting pauses

# Provider API Keys (Optional - at least one recommended)
OPENAI_KEY=                     # https://platform.openai.com/api-keys
CLAUDE_KEY=                     # https://console.anthropic.com/
GEMINI_KEY=                     # https://aistudio.google.com/app/apikey
GROK_KEY=                       # https://console.x.ai/

# Free Provider Configuration (No authentication needed!)
# The free provider now works completely without any cookies or authentication

# ---------------------------------------------------------------------------
# Pi/OpenClaw Agent Configuration (Local LLM Stack)
# ---------------------------------------------------------------------------
# Base Ollama URL (Pi adds /v1 for OpenAI-compatible API)
OLLAMA_URL=http://localhost:11434

# Primary Ollama model (used by most systems)
OLLAMA_MODEL=qwen3-8b-slim:latest
OLLAMA_FAST_MODEL=qwen3-8b-slim:latest

# QwenAgent - Fast local inference for quick tasks
QWEN_MODEL=qwen3-8b-slim:latest

# KimiAgent - Complex reasoning tasks (missions, bulletins)
KIMI_MODEL=qwen3-8b-slim:latest
KIMI_ENABLE_SUBAGENTS=false      # Subagents require cloud — disabled for local-only

# Default Settings
DEFAULT_PROVIDER=free           # Options: free, openai, claude, gemini, grok
DEFAULT_MODEL=auto             # auto selects best model for provider

# Security Settings
ADMIN_USER_IDS=                 # Comma-separated Discord user IDs for admin access
MAX_CONVERSATION_LENGTH=20      # Maximum conversation history length
CONVERSATION_TRIM_SIZE=8        # Messages to keep when trimming history

# Module Council (4-pass quality generation)
MODULE_USE_COUNCIL=false        # true = Architect + Rules Expert + Bob (Salvatore) + Synthesis
                                # Produces richer, DM-runnable modules at ~4x generation time

# Real-world weather for city scene image generator (uses wttr.in, no API key needed)
# Accepts city name, zip code, or "lat,lon"
REAL_WEATHER_LOCATION=           # e.g. 62234  or  "St. Louis, MO"

# Map generation
MODULE_GENERATE_MAPS=true
A1111_MAPCRAFT_ENABLED=true
VTT_MAP_PRETTY=true
VTT_MAP_PRETTY_MAPCRAFT_TEXT2IMG=false
VTT_MAP_PRETTY_INCLUDE_FLUX=false
VTT_MAP_PRETTY_DENOISE=0.32
# Leave VAE override variables blank; this rig should let A1111/model defaults handle VAE.
