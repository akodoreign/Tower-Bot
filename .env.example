# TowerBot example environment
# Copy this file to .env and fill in real secrets/IDs locally. Do not commit .env.

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
REPLYING_ALL_DISCORD_CHANNEL_ID=
MISSION_BOARD_CHANNEL_ID=
MAPS_CHANNEL_ID=
CHAR_MONITOR_CHANNEL_ID=
ADMIN_USER_IDS=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=towerbot
MYSQL_PASSWORD=
MYSQL_DB=towerbot

# Local LLM / Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-8b-slim:latest
OLLAMA_FAST_MODEL=qwen3-8b-slim:latest
QWEN_MODEL=qwen3-8b-slim:latest
KIMI_MODEL=qwen3-8b-slim:latest
KIMI_ENABLE_SUBAGENTS=false

# Optional cloud providers
OPENAI_ENABLED=false
OPENAI_KEY=
CLAUDE_KEY=
GEMINI_KEY=
GROK_KEY=
DEFAULT_PROVIDER=free
DEFAULT_MODEL=auto

# A1111 / image generation
A1111_URL=http://127.0.0.1:7860
A1111_MODEL=
A1111_MAP_CHECKPOINT=
A1111_MAPCRAFT_ENABLED=true
A1111_NO_IMAGE_ALERT_THRESHOLD=5
A1111_NO_IMAGE_ALERT_COOLDOWN=3600
A1111_NO_IMAGE_BUGLOG_ENABLED=1
# Leave VAE override variables blank on this rig. VAE overrides have broken generation before.
A1111_SCENE_VAE=

# Mission/module generation
MODULE_GENERATE_MAPS=true
MODULE_USE_COUNCIL=false
VTT_MAP_PRETTY=true
VTT_MAP_PRETTY_MAPCRAFT_TEXT2IMG=false
VTT_MAP_PRETTY_INCLUDE_FLUX=false
VTT_MAP_PRETTY_DENOISE=0.32

# Mimir / D&D tools
MIMIR_MCP_PATH=
MIMIR_CAMPAIGN_ID=
MIMIR_CAMPAIGN_NAME=Tower of Last Chance
MIMIR_DATABASE_PATH=
MIMIR_LOG_LEVEL=warn
DDB_COBALT_TOKEN=
DDB_COBALT_SESSION=

# Self-learning window, local 24h clock
LEARN_HOUR_START=1
LEARN_HOUR_END=4

# Bot behavior
LOGGING=True
REPLYING_ALL=False
MAX_CONVERSATION_LENGTH=20
CONVERSATION_TRIM_SIZE=8
REAL_WEATHER_LOCATION=
